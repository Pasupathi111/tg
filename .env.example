# ---- Required ----
# Long random string, different per environment. Generate: openssl rand -hex 32
WEBUI_SECRET_KEY=

# ---- Docker / networking ----
TG_PORT=3000
TG_DOCKER_TAG=latest
# Public URL users open in the browser, e.g. https://tg-dev.example.com
WEBUI_URL=http://localhost:3000
CORS_ALLOW_ORIGIN=http://localhost:3000

# ---- App ----
WEBUI_NAME=TG
WEBUI_AUTH=true
# true only while creating the first admin account, then set to false
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending

# ---- AI (all optional; Billing Coworker works without any key) ----
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=false
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# ---- Offline / first start ----
OFFLINE_MODE=false
